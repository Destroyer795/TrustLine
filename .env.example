# TrustLine Environment Configuration

# Django Core Settings
SECRET_KEY=trustline-production-hackathon-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL in Docker, SQLite fallback for unit tests)
POSTGRES_DB=trustline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
USE_SQLITE_TEST=false

# LLM Explainer (Optional Gemini API key; falls back to deterministic rule engine if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS & Gateway Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
VITE_API_BASE_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
